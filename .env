# ============================================================
# FRONTEND ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values
# ============================================================

# Backend API Base URL
# Local development uses the local backend URL.
# For Vercel production, set REACT_APP_API_BASE_URL to your Railway backend URL.
REACT_APP_API_BASE_URL=http://localhost:5001/api

# App Info
REACT_APP_PORTFOLIO_NAME=Shelu Singh
REACT_APP_PORTFOLIO_TITLE=Cloud & DevOps Engineer

# Environment
REACT_APP_ENV=development
PORT=3001
